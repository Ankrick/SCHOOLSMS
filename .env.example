PORT=5000
MONGO_URI=mongodb+srv://tn8070250_db_user:tn8070250_db_user@cluster0.bxywbav.mongodb.net/?appName=Cluster0
NODE_ENV=development

# Owner login — sees everything: dashboard, students, batches, invoices, payment history.
# Optional; leave unset to disable the owner login (the server still starts).
OWNER_USERNAME=owner
OWNER_PASSWORD=changeme789

# Admin login — finance only: invoices and payment history. Can read students and batches
# (invoices show their names) but cannot add, edit or delete them.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Students-admin login — students and batches, class fees included. No billing records.
STUDENTS_ADMIN_USERNAME=students_admin
STUDENTS_ADMIN_PASSWORD=changeme456

# Secret used to sign login tokens. Use a long random string; changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string
