PORT=5001
MONGO_URI=mongodb+srv://tn8070250_db_user:tn8070250_db_user@cluster0.bxywbav.mongodb.net/?appName=Cluster0
NODE_ENV=development

# Owner login — sees everything: dashboard, students, batches, invoices, payment history.
# Optional; leave unset to disable the owner login (the server still starts).
OWNER_USERNAME=owner
OWNER_PASSWORD=changeme789

# Finance logins — students and batches (add, edit, delete; fees included), invoices and
# payment history. Any number, as username:password pairs separated by commas. A password
# may contain ":" but not ",".
FINANCE_ACCOUNTS=finance_user:changeme123

# Operator logins — read-only students: name, batch, parent phone and student Telegram.
# No fees, no billing. Same format as FINANCE_ACCOUNTS.
OPERATOR_ACCOUNTS=operator1:changeme456,operator2:changeme789

# Secret used to sign login tokens. Use a long random string; changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string
