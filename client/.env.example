# Local dev only: where `npm run dev`'s proxy forwards /api requests. Defaults to http://localhost:5000.
VITE_DEV_BACKEND_URL=http://localhost:5000

# Production: LEAVE THIS UNSET.
#
# vercel.json rewrites /api/* to the Render backend, so the browser only ever talks to the
# Vercel domain. That keeps every request same-origin, which means no CORS and no OPTIONS
# preflight — some mobile networks (Myanmar carriers especially) block or mangle preflight
# requests, which broke login for those users when the API was called cross-origin.
#
# Setting this to the backend's full URL sends the browser straight to onrender.com again
# and reintroduces that breakage. Change the destination in client/vercel.json instead.
# VITE_API_URL=https://your-backend-domain.com/api
